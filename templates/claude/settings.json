{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agent-ready/sync.mjs\" stop" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|.*create_pull_request",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/agent-ready/sync.mjs\" pre-pr" }]
      }
    ]
  }
}
